{
  "name": "shop",
  "private": true,
  "type": "module",
  "description": "Perf Coffee: the demo shop of the workshop, a React single-page app",
  "scripts": {
    "dev": "npm run fonts && vite",
    "build": "npm run fonts && vite build",
    "fonts": "node scripts/copy-fonts.mjs",
    "images": "node scripts/fetch-images.mjs",
    "start": "node server.mjs",
    "test": "node --test --test-concurrency=1 \"src/**/*.test.ts\" \"*.test.mjs\"",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@fontsource/fraunces": "5.3.0",
    "@types/node": "22.20.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.3.0",
    "playwright": "1.63.0",
    "typescript": "7.0.2",
    "vite": "8.3.7"
  },
  "engines": {
    "node": ">=22.18"
  }
}
