{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "npm run build && node static-pages.mjs",
  "outputDirectory": "dist-static",
  "cleanUrls": true,
  "rewrites": [
    { "source": "/thirdparty/:path", "destination": "/api/thirdparty?path=:path" },
    { "source": "/collect", "destination": "/api/thirdparty?path=collect" },
    { "source": "/((?!api/).*)", "destination": "/app" }
  ],
  "headers": [
    { "source": "/assets/(.*)", "headers": [{ "key": "cache-control", "value": "public, max-age=31536000, immutable" }] },
    { "source": "/(images|fonts)/(.*)", "headers": [{ "key": "cache-control", "value": "public, max-age=3600" }] }
  ]
}
